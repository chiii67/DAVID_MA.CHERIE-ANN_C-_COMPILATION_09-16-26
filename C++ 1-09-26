int main () 	{
//--Declare variables of different data types--
	int age  = 20; //--types--variables==value--(whole number)
	double price = 19.99; //decimal number  (double precision)
	float weight = 65.5f; //decimal number (single precision, using the 'f')
	char grade = 'A'; //single quotes for single character
	bool isStudent = true; //True or False
	string name = "Maria"; //text
//---Output using cout---
	cout <<"Name: "<<name <<endl; //Output:Maria
	cout <<"Age: "<<age <<endl; //Output:20
	cout <<"Price: "<<price <<endl; //Output:19.99
	cout <<"Weight: "<<weight <<endl; //Output:65.50
	cout <<"Grade: "<<grade <<endl; //Output:A
	cout <<"Is student? "<<isStudent <<endl; //True or Flase --- Output:true
	return 0;
}

//---- Getting input using cin ----
#include<iostream>
#include<string>
using namespace std;

int main () 	{
	string userCity;
	cout <<"\nEnter your city: ";
	cin>> userCity; //read one word(stops at whitespace)
	cout <<"You live in: "<<userCity <<endl;
//---- reading a full line (including spaces) ---
	cin.ignore(); // clear leftover newline character from previous cin

	string fullSentence;
